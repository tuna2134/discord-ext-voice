From 46ecb91dbddbf7c651e4c2812e4c09408d09b21a Mon Sep 17 00:00:00 2001
From: discord-ext-voice <dev@example.invalid>
Date: Thu, 15 Oct 2026 20:29:30 +0900
Subject: [PATCH] resampler: accept frames with an unspecified channel layout

`ffw_audio_resampler_push_frame` hands the caller's frame straight to
`swr_convert_frame`. Decoders routinely leave the channel layout of plain PCM
streams unspecified ("2 channels, order unspecified"), while `swr_alloc_set_opts2`
resolves such a layout to the default one for that channel count. `swr_convert_frame`
therefore sees different input parameters, tries to reconfigure the context through
`swr_config_frame`, and - because that fails for an unspecified layout - returns
`AVERROR_INPUT_CHANGED` ("Input changed"). Resampling a plain WAV file fails:

    FFmpeg resampler error: Input changed

Fix this by normalising a shallow copy of the frame to `av_channel_layout_default`
for its channel count before converting. The sample data is reference counted, so the
copy shares it and nothing is duplicated. When the frame's layout is already usable,
or the copy cannot be allocated, the original frame is passed through as before.

The same normalisation is applied to the deprecated `uint64_t channel_layout` path.
---
 ac-ffmpeg/src/codec/audio/resampler.c | 63 ++++++++++++++++++++++++++-
 1 file changed, 62 insertions(+), 1 deletion(-)

diff --git a/ac-ffmpeg/src/codec/audio/resampler.c b/ac-ffmpeg/src/codec/audio/resampler.c
index 1d3312f..7b418cb 100644
--- a/ac-ffmpeg/src/codec/audio/resampler.c
+++ b/ac-ffmpeg/src/codec/audio/resampler.c
@@ -1,3 +1,5 @@
+#include <libavutil/channel_layout.h>
+#include <libavutil/frame.h>
 #include <libswresample/swresample.h>
 
 typedef struct AudioResampler {
@@ -173,12 +175,64 @@ err:
 }
 #endif
 
+/// Return a shallow copy of `frame` whose channel layout has been replaced by the default
+/// layout for its channel count, or NULL when the frame's layout is already usable.
+///
+/// Decoders routinely leave the channel layout of plain PCM streams unspecified (for example
+/// "2 channels, order unspecified"). `swr_alloc_set_opts2` resolves such a layout to the
+/// default one for that channel count, so `swr_convert_frame` sees the frame's unspecified
+/// layout as a change of input parameters, tries to reconfigure the context and fails with
+/// `AVERROR_INPUT_CHANGED`. Handing it a frame with the resolved layout avoids that.
+static AVFrame* frame_with_default_channel_layout(const AVFrame* frame) {
+    AVFrame* copy;
+    int channels;
+
+#ifdef FFW_FEATURE_CHANNEL_LAYOUT_V2
+    channels = frame->ch_layout.nb_channels;
+
+    if (frame->ch_layout.order != AV_CHANNEL_ORDER_UNSPEC
+        && av_channel_layout_check(&frame->ch_layout)) {
+        return NULL;
+    }
+#else
+    channels = frame->channels;
+
+    if (frame->channel_layout != 0) {
+        return NULL;
+    }
+#endif
+
+    if (channels <= 0) {
+        return NULL;
+    }
+
+    // The sample data is reference counted, so the copy only shares it.
+    copy = av_frame_clone(frame);
+
+    if (!copy) {
+        return NULL;
+    }
+
+#ifdef FFW_FEATURE_CHANNEL_LAYOUT_V2
+    // `av_channel_layout_uninit` clears `nb_channels` as well, hence the saved value.
+    av_channel_layout_uninit(&copy->ch_layout);
+    av_channel_layout_default(&copy->ch_layout, channels);
+#else
+    copy->channel_layout = av_get_default_channel_layout(channels);
+#endif
+
+    return copy;
+}
+
 int ffw_audio_resampler_push_frame(AudioResampler* resampler, const AVFrame* frame) {
     int required_capacity;
     int ret;
 
     int64_t pts_delta;
 
+    AVFrame* normalised_frame;
+    const AVFrame* input_frame;
+
     // check if the internal frame has been consumed
     if (resampler->tmp_frame && (resampler->offset < resampler->tmp_frame->nb_samples)) {
         return 0;
@@ -253,7 +307,14 @@ int ffw_audio_resampler_push_frame(AudioResampler* resampler, const AVFrame* fra
     resampler->tmp_frame->nb_samples = 0;
     resampler->offset = 0;
 
-    ret = swr_convert_frame(resampler->resample_context, resampler->tmp_frame, frame);
+    normalised_frame = frame ? frame_with_default_channel_layout(frame) : NULL;
+    input_frame = normalised_frame ? normalised_frame : frame;
+
+    ret = swr_convert_frame(resampler->resample_context, resampler->tmp_frame, input_frame);
+
+    if (normalised_frame) {
+        av_frame_free(&normalised_frame);
+    }
 
     if (ret < 0) {
         return ret;
-- 
